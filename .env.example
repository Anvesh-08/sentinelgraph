# SentinelGraph Environment Configuration Template
# Copy this file to .env for local development. NEVER commit .env to version control.

SENTINELGRAPH_ENV=development
SENTINELGRAPH_HOST=127.0.0.1
SENTINELGRAPH_PORT=8000
SENTINELGRAPH_DB_PATH=./data/runtime/sentinelgraph.db
SENTINELGRAPH_LOG_LEVEL=INFO

# Security & Cryptographic Settings (Replace with generated 256-bit keys in local .env)
SENTINELGRAPH_TOKEN_SECRET=replace-with-secure-local-random-hex-key-min-64-chars
SENTINELGRAPH_AUDIT_HMAC_KEY=replace-with-secure-local-audit-hmac-signing-key-64-chars
SENTINELGRAPH_TOKEN_TTL_SECONDS=28800
SENTINELGRAPH_PASSWORD_PBKDF2_ITERATIONS=210000

# Monitoring & Graph Traversal Limits
SENTINELGRAPH_MAX_GRAPH_HOPS=6
SENTINELGRAPH_MAX_GRAPH_NODES=500
SENTINELGRAPH_CTR_THRESHOLD_USD=10000.00
SENTINELGRAPH_SAR_THRESHOLD_USD=5000.00
SENTINELGRAPH_HIGH_RISK_SCORE_CUTOFF=70.0
